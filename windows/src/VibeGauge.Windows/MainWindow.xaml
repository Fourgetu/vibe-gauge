<Window x:Class="VibeGauge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VibeGauge.Windows"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="VibeGauge" Width="420" Height="860" MinWidth="420" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Topmost="True" Background="Transparent" AllowsTransparency="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="66" ResizeBorderThickness="5" CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ToneTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Good"><Setter Property="Foreground" Value="{StaticResource GoodBrush}" /></Trigger>
                <Trigger Property="Tag" Value="Warning"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></Trigger>
                <Trigger Property="Tag" Value="Danger"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowSurface" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="66" /><RowDefinition Height="*" /><RowDefinition Height="45" /></Grid.RowDefinitions>
            <Grid x:Name="CaptionArea" Background="Transparent">
                <Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Width="32" Height="3" CornerRadius="2" Background="{StaticResource GripBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                <Grid Grid.Row="1" Margin="15,0,10,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="7" Padding="2" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PlansTab" Content="订阅" GroupName="Navigation" Tag="0" Style="{StaticResource SegmentStyle}" IsChecked="{Binding IsSubscriptionSelected, Mode=OneWay}" Click="Nav_Click" />
                            <RadioButton Content="API" GroupName="Navigation" Tag="1" Style="{StaticResource SegmentStyle}" IsChecked="{Binding IsApiSelected, Mode=OneWay}" Click="Nav_Click" />
                            <RadioButton Content="统计" GroupName="Navigation" Tag="3" Style="{StaticResource SegmentStyle}" IsChecked="{Binding IsStatsSelected, Mode=OneWay}" Click="Nav_Click" />
                            <RadioButton Content="网络" GroupName="Navigation" Tag="4" Style="{StaticResource SegmentStyle}" IsChecked="{Binding IsNetworkSelected, Mode=OneWay}" Click="Nav_Click" />
                            <RadioButton Content="系统" GroupName="Navigation" Tag="2" Style="{StaticResource SegmentStyle}" IsChecked="{Binding IsSystemSelected, Mode=OneWay}" Click="Nav_Click" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="HeaderMemory" Grid.Column="1" Text="{Binding HeaderMemoryText}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,0,7,0" Visibility="Collapsed" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="ThemeButton" Style="{StaticResource IconButtonStyle}" ToolTip="切换为浅色毛玻璃" AutomationProperties.Name="切换为浅色毛玻璃" Click="Theme_Click"><TextBlock x:Name="ThemeIcon" Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" /></Button>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="立即刷新" AutomationProperties.Name="立即刷新" Click="Refresh_Click"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" /></Button>
                        <ToggleButton x:Name="PinButton" Style="{StaticResource PinStyle}" ToolTip="固定窗口，点击外部不收起" AutomationProperties.Name="固定窗口" Click="Pin_Click"><TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /></ToggleButton>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="收起到托盘" AutomationProperties.Name="收起到托盘" Click="Hide_Click"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" /></Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Margin="15,0,10,0">
                <local:PlansPanel x:Name="PlansView" Visibility="{Binding IsSubscriptionSelected, Converter={StaticResource BoolToVisibility}}" />
                <local:StatisticsPanel x:Name="StatisticsView" Visibility="{Binding IsStatsSelected, Converter={StaticResource BoolToVisibility}}" />
                <local:NetworkPanel x:Name="NetworkView" Visibility="{Binding IsNetworkSelected, Converter={StaticResource BoolToVisibility}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsApiSelected, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,0,5,12">
                        <TextBlock Text="API Proxy" Style="{StaticResource SectionTitleStyle}" Margin="0,2,0,10" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid><TextBlock Text="{Binding ProxyStatusText}" FontWeight="SemiBold" Tag="{Binding ProxyTone}" Style="{StaticResource ToneTextStyle}" /><TextBlock Text="{Binding ProxyEndpoint}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" /></Grid>
                                <TextBlock Text="{Binding ProxyDetail}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                <Grid>
                                    <CheckBox Content="随应用启动" IsChecked="{Binding AutoStartProxy}" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="复制前缀" Style="{StaticResource ActionButtonStyle}" Click="CopyProxyPrefix_Click" Margin="0,0,6,0" /><Button Content="{Binding ProxyActionText}" Style="{StaticResource ActionButtonStyle}" Click="ToggleProxy_Click" /></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,18,0,10">
                            <TextBlock Text="API 使用量" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="2" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal">
                                <RadioButton Content="今日" GroupName="ApiRange" Tag="today" Style="{StaticResource SegmentStyle}" IsChecked="{Binding IsApiToday, Mode=OneWay}" Click="ApiRange_Click" />
                                <RadioButton Content="7D" GroupName="ApiRange" Tag="7d" Style="{StaticResource SegmentStyle}" IsChecked="{Binding IsApi7Days, Mode=OneWay}" Click="ApiRange_Click" />
                                <RadioButton Content="30D" GroupName="ApiRange" Tag="30d" Style="{StaticResource SegmentStyle}" IsChecked="{Binding IsApi30Days, Mode=OneWay}" Click="ApiRange_Click" />
                                <RadioButton Content="全部" GroupName="ApiRange" Tag="all" Style="{StaticResource SegmentStyle}" IsChecked="{Binding IsApiAll, Mode=OneWay}" Click="ApiRange_Click" />
                            </StackPanel></Border>
                        </Grid>
                        <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{Binding ApiHeadline}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding ApiDetail}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                        <TextBlock Text="服务商" Style="{StaticResource SectionTitleStyle}" Margin="0,17,0,8" Visibility="{Binding HasApiProviders, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding ApiProviders}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6"><StackPanel>
                                <Grid><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Calls}" HorizontalAlignment="Right" Foreground="{StaticResource GoodBrush}" /></Grid>
                                <TextBlock Text="{Binding Metrics}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CacheText}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" /><TextBlock Text="{Binding HealthText}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                            </StackPanel></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="模型" Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,8" Visibility="{Binding HasApiModels, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding ApiModels}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6"><StackPanel>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Calls}" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock Text="{Binding Model}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></DockPanel>
                                <TextBlock Text="{Binding Provider}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding Metrics}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="最近调用" Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,8" Visibility="{Binding HasApiRecent, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding ApiRecent}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6"><StackPanel>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding Model}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></DockPanel>
                                <WrapPanel Margin="0,5,0,0"><TextBlock Text="{Binding Provider}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding Tokens, StringFormat= · 总 Token {0}}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding Status, StringFormat= · {0}}" Tag="{Binding Tone}" Style="{StaticResource ToneTextStyle}" /></WrapPanel>
                            </StackPanel></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,8" /><local:UsageKeysPanel />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsSystemSelected, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,0,5,12">
                        <TextBlock Text="系统资源" Style="{StaticResource SectionTitleStyle}" Margin="0,2,0,10" />
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,7"><StackPanel><Grid><TextBlock Text="内存" FontWeight="SemiBold" /><TextBlock Text="{Binding MemoryText}" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" /></Grid><ProgressBar Value="{Binding MemoryUsedPercent, Mode=OneWay}" Style="{StaticResource CompactProgressStyle}" Margin="0,9,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,7"><StackPanel><Grid><TextBlock Text="系统磁盘" FontWeight="SemiBold" /><TextBlock Text="{Binding DiskText}" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" /></Grid><ProgressBar Value="{Binding DiskUsedPercent, Mode=OneWay}" Style="{StaticResource CompactProgressStyle}" Margin="0,9,0,0" /></StackPanel></Border>
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,3,0"><StackPanel><TextBlock Text="CPU" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding CpuText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}" Margin="3,0,0,0"><StackPanel><TextBlock Text="虚拟内存" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding PageFileText}" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border>
                        </UniformGrid>
                        <local:SettingsPanel Margin="0,5,0,9" />
                        <TextBlock Text="进程与清理" Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,8" />
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,7"><StackPanel><TextBlock Text="活动 MCP" FontWeight="SemiBold" /><TextBlock Text="{Binding McpText}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" /><TextBlock Text="{Binding NpxText}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}"><StackPanel>
                            <Grid><StackPanel><TextBlock Text="断链 MCP" FontWeight="SemiBold" /><TextBlock Text="{Binding OrphanCount, StringFormat=发现 {0} 个候选进程}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" /></StackPanel><Button Content="清理" HorizontalAlignment="Right" Style="{StaticResource ActionButtonStyle}" Click="Clean_Click" /></Grid>
                            <ItemsControl ItemsSource="{Binding Orphans}" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding MemoryMb, StringFormat={}{0:0} MB}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding ServiceName}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" /></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="15,5,15,0">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                    <Button DockPanel.Dock="Left" Content="退出 VibeGauge" Background="Transparent" BorderThickness="0" Padding="0,4" FontSize="12" Style="{StaticResource ActionButtonStyle}" Click="Exit_Click" />
                    <CheckBox DockPanel.Dock="Right" Content="开机启动" IsChecked="{Binding StartupEnabled}" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
